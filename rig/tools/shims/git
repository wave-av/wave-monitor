#!/usr/bin/env bash
# RIG SHIM: hermetic git. Logs every invocation to $RIG_SHIMLOG, emulates
# deterministically, never touches the network. A non-empty shim log proves the
# script under test proceeded past its fork-refusal point.
echo "git $*" >> "${RIG_SHIMLOG:?RIG_SHIMLOG unset}"
case "${1:-}" in
  fetch) exit 0 ;;
  merge-base) echo "deadbeefdeadbeefdeadbeefdeadbeefdeadbeef"; exit 0 ;;
  rev-parse)
    if [ "${2:-}" = "--is-shallow-repository" ]; then echo "false";
    else echo "deadbeefdeadbeefdeadbeefdeadbeefdeadbeef"; fi
    exit 0 ;;
  hash-object) echo "4b825dc642cb6eb9a060e54bf8d69288fbee4904"; exit 0 ;;
  *) exit 0 ;;
esac
